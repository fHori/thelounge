{
  "name": "thelounge",
  "description": "The self-hosted Web IRC client",
  "version": "2026.11.3-rc.3",
  "type": "module",
  "preferGlobal": true,
  "bin": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/fHori/thelounge.git"
  },
  "homepage": "https://github.com/fHori/thelounge",
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsc --build server/tsconfig.json",
    "build": "run-p --aggregate-output build:client build:server",
    "coverage": "vitest run --coverage",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts start --dev",
    "format:prettier": "prettier --write \"**/*.*\"",
    "lint:eslint": "eslint . --report-unused-disable-directives --color",
    "lint:prettier": "prettier --list-different \"**/*.*\"",
    "lint:stylelint": "stylelint --color \"client/**/*.css\"",
    "lint:types": "vue-tsc -p client --noEmit && tsc -p server --noEmit && tsc -p shared --noEmit && tsc -p test --noEmit",
    "lint": "run-p --aggregate-output --continue-on-error lint:eslint lint:prettier lint:stylelint lint:types",
    "start": "node index start",
    "test": "run-p --aggregate-output --continue-on-error lint:eslint lint:prettier lint:stylelint lint:types test:vitest",
    "test:vitest": "vitest run",
    "watch": "vite build --watch",
    "githooks-install": "git config core.hooksPath scripts/git-hooks"
  },
  "keywords": [
    "lounge",
    "browser",
    "web",
    "chat",
    "client",
    "irc",
    "server",
    "thelounge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./.thelounge_home",
    "./index.js",
    "./yarn.lock",
    "./dist/package.json",
    "./dist/**/*.js",
    "./public/**"
  ],
  "dependencies": {
    "@fastify/busboy": "3.2.6",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "commander": "14.0.2",
    "content-disposition": "0.5.4",
    "express": "5.3.0",
    "file-type": "21.3.4",
    "filenamify": "7.0.3",
    "irc-framework": "patch:irc-framework@npm%3A4.14.0#~/.yarn/patches/irc-framework-npm-4.14.0-807fa50.patch",
    "ldapts": "8.0.9",
    "linkify-it": "5.0.2",
    "lodash": "4.18.1",
    "mime": "^4.1.0",
    "node-forge": "1.4.3",
    "package-json": "10.0.1",
    "read": "5.0.1",
    "read-chunk": "5.0.0",
    "semver": "7.8.6",
    "socket.io": "4.8.4",
    "tlds": "1.261.0",
    "ua-parser-js": "2.0.10",
    "undici": "7.30.2",
    "uuid": "14.0.3",
    "web-push-neo": "0.1.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.4.1"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@textcomplete/core": "0.1.13",
    "@textcomplete/textarea": "0.1.13",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/chai": "5.2.3",
    "@types/content-disposition": "0.5.8",
    "@types/express": "5.0.6",
    "@types/linkify-it": "3.0.5",
    "@types/lodash": "4.17.27",
    "@types/mousetrap": "1.6.15",
    "@types/node": "24.13.3",
    "@types/read": "0.0.32",
    "@types/semver": "7.8.0",
    "@types/sinon": "^20.0.0",
    "@types/sortablejs": "1.15.9",
    "@types/ua-parser-js": "0.7.39",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-istanbul": "5.0.0",
    "@vue/runtime-dom": "3.5.45",
    "@vue/test-utils": "2.6.0",
    "chai": "6.3.0",
    "cross-env": "7.0.3",
    "cssnano": "9.9.0",
    "dayjs": "1.11.23",
    "emoji-regex": "11.0.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "fuzzy": "0.1.3",
    "globals": "16.5.0",
    "jsdom": "31.0.1",
    "mousetrap": "1.6.5",
    "normalize.css": "8.0.1",
    "npm-run-all2": "5.0.0",
    "postcss": "8.5.33",
    "postcss-import": "16.1.1",
    "postcss-preset-env": "10.4.0",
    "prettier": "3.10.1",
    "pretty-quick": "4.2.2",
    "primer-tooltips": "2.0.0",
    "sinon": "21.0.0",
    "socket.io-client": "4.8.4",
    "sortablejs": "1.15.7",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "36.0.1",
    "ts-sinon": "2.0.2",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "undate": "0.3.0",
    "vite": "8.3.6",
    "vitest": "5.0.0",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vue-router": "5.3.1",
    "vue-tsc": "3.3.14",
    "vuex": "4.1.0"
  },
  "resolutions": {
    "js-yaml": "^4.1.1"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
